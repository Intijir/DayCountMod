{
  "schemaVersion": 1,
  "id": "daycountmod",
  "version": "${version}",
  "name": "Day Count",
  "description": "This mod displays the current minecraft day in the top left (location adjustable).",
  "authors": [
    "Intijir, original creator",
    "MC Mods Pete, mcmods.pete@gmail.com"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/day-count-mod",
    "sources": "https://github.com/MC-Mods-Pete/DayCountMod",
    "issues": "https://github.com/MC-Mods-Pete/DayCountMod/issues"
  },
  "license": "MIT",
  "icon": "assets/daycountmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "com.intijir.daycount.DayCountClient"
    ],
    "main": [
      "com.intijir.daycount.DayCount"
    ],
    "modmenu": [
      "com.intijir.daycount.util.ModMenuIntegration"
    ]
  },
  "mixins": [
    "DayCountMod.mixins.json"
  ],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": ">=15.0.127"
	},
	"suggests": {
		"modmenu": ">=11.0.1",
		"another-mod": "*"
	}
}
